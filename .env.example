# SEC requests use official SEC data APIs only; secThing is not a website scraper.
# Replace with a descriptive personal or organizational contact before ingestion.
SEC_USER_AGENT=secThing/0.1.0 PersonalUse your-name@example.com
# Five requests/second is the conservative default. The application rejects values above 10.
SEC_RATE_LIMIT_PER_SECOND=5

POSTGRES_DB=secthing
POSTGRES_USER=secthing
POSTGRES_PASSWORD=change-me-before-network-exposure
DATABASE_URL=postgresql://secthing:change-me-before-network-exposure@postgres:5432/secthing
DATA_DIR=/app/data

# Default mode makes no AI requests; SEC metadata ingestion remains fully usable.
# For the bundled Ollama profile, set AI_MODE=local and choose model names.
# Compose automatically downloads missing chat/embedding models into ollama-data.
AI_MODE=disabled
AI_CHAT_PROVIDER=ollama
AI_CHAT_BASE_URL=http://ollama:11434
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_CONTEXT_WINDOW=8192
AI_CHAT_MAX_OUTPUT_TOKENS=1024
AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_BASE_URL=http://ollama:11434
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSION=
# Finite idle residency; 0 releases immediately. Never pins the GPU indefinitely.
AI_MODEL_KEEP_ALIVE_SECONDS=120
# Bounded cooperative queue shared by backend and worker for each local endpoint.
AI_QUEUE_WAIT_MS=60000
AI_QUEUE_LIMIT=16
AI_EMBEDDING_BATCH_SIZE=8
# One inference at a time avoids multiplying context memory on small machines.
OLLAMA_NUM_PARALLEL=1
AI_REQUEST_TIMEOUT_MS=60000
LOCAL_ONLY=true

# Used by the Next.js server to proxy same-origin browser API calls in Compose.
BACKEND_API_URL=http://localhost:8080
BACKEND_PORT=8080
FRONTEND_PORT=3000
