# A descriptive contact is required before Phase 2 enables SEC requests.
SEC_USER_AGENT=secThing/0.1.0 admin@example.com

POSTGRES_DB=secthing
POSTGRES_USER=secthing
POSTGRES_PASSWORD=change-me-before-network-exposure
DATABASE_URL=postgresql://secthing:change-me-before-network-exposure@postgres:5432/secthing
DATA_DIR=/app/data

# Phase 1 does not invoke an AI provider. Keep disabled until Phase 7.
AI_MODE=disabled
AI_CHAT_PROVIDER=
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_CONTEXT_WINDOW=
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSION=
LOCAL_ONLY=true

VITE_API_BASE_URL=http://localhost:8080
BACKEND_PORT=8080
FRONTEND_PORT=3000

