# SEC requests use official SEC data APIs only; secThing is not a website scraper.
# Replace with a descriptive personal or organizational contact before ingestion.
SEC_USER_AGENT=secThing/0.1.0 PersonalUse your-name@example.com
# Five requests/second is the conservative default. The application rejects values above 10.
SEC_RATE_LIMIT_PER_SECOND=5

POSTGRES_DB=secthing
POSTGRES_USER=secthing
POSTGRES_PASSWORD=change-me-before-network-exposure
DATABASE_URL=postgresql://secthing:change-me-before-network-exposure@postgres:5432/secthing
DATA_DIR=/app/data

# Phase 1 does not invoke an AI provider. Keep disabled until Phase 7.
AI_MODE=disabled
AI_CHAT_PROVIDER=
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_CONTEXT_WINDOW=
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSION=
LOCAL_ONLY=true

# Used by the Next.js server to proxy same-origin browser API calls in Compose.
BACKEND_API_URL=http://localhost:8080
BACKEND_PORT=8080
FRONTEND_PORT=3000
